      <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14zM8.3 18.3v-7H6v7h2.3zM7.1 10a1.3 1.3 0 100-2.7 1.3 1.3 0 000 2.7zm11.2 8.3v-3.9c0-2.1-1.1-3.1-2.7-3.1-1.2 0-1.8.7-2.1 1.2v-1H11.5s0 .6 0 7h2.3v-3.9c0-.2 0-.4.1-.6.2-.4.5-.9 1.2-.9.9 0 1.2.7 1.2 1.6v3.8h2.3z"/></svg></a>
      <a href="mailto:xliu713@aucklanduni.ac.nz" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap foot">
    <span>© 2026 Lily · built from scratch with care</span>
    <span>Auckland, New Zealand</span>
  </div>
</footer>

</div>
<script src="<%- url_for('/js/script.js') %>"></script>
</body>
</html>
