<!DOCTYPE html>
<html lang="<%= config.language || 'en-NZ' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= config.description %>">
  <meta name="author" content="<%= config.author %>">
  <meta name="theme-color" content="#f4f1e8">
  <meta property="og:title" content="Lily Liu — Graduate Software Engineer">
  <meta property="og:description" content="<%= config.description %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= config.url %>/">
  <meta property="og:locale" content="en_NZ">
  <title>Lily Liu — Graduate Software Engineer</title>
  <link rel="canonical" href="<%= config.url %>/">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="page-shell">
    <nav class="site-nav" id="nav" aria-label="Primary navigation">
      <div class="wrap nav-inner">
        <a class="logo" href="#top" aria-label="Lily Liu, home">Lily<span>.</span></a>

        <div class="nav-links" id="navLinks">
          <a href="#work">Work</a>
          <a href="#experience">Experience</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
          <a class="button button-small" href="#contact">Let’s talk</a>
        </div>

        <button class="nav-toggle" id="navBtn" type="button" aria-label="Open menu" aria-controls="navLinks" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <main id="main">
      <header class="hero wrap" id="top">
        <div class="hero-copy reveal">
          <p class="eyebrow">&gt;_ hello, I’m Lily</p>
          <h1>I build useful software for <em>real-world problems.</em></h1>
          <p class="hero-role">Graduate Software Engineer · Full-stack Development</p>
          <p class="hero-intro">I bring three years of professional frontend experience and a growing full-stack toolkit to products that need clear thinking, reliable engineering and thoughtful user experiences.</p>

          <div class="hero-actions">
            <a class="button" href="#work">View my work <span aria-hidden="true">→</span></a>
            <a class="button button-ghost" href="https://github.com/xiyunliu610" target="_blank" rel="noopener noreferrer">GitHub profile <span aria-hidden="true">↗</span></a>
          </div>

          <div class="hero-meta" aria-label="Contact details">
            <span>Auckland, New Zealand</span>
            <a href="mailto:xliu713@aucklanduni.ac.nz">xliu713@aucklanduni.ac.nz</a>
            <a href="https://github.com/xiyunliu610" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/xiyun-liu/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          </div>
        </div>

        <aside class="profile-card reveal" aria-label="Career snapshot">
          <div class="terminal-bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <p>lily.profile.ts</p>
          </div>
          <pre aria-label="A short description in code"><code><span class="code-keyword">const</span> lily = {
  focus: <span class="code-string">"useful products"</span>,
  approach: [
    <span class="code-string">"methodical"</span>,
    <span class="code-string">"collaborative"</span>,
    <span class="code-string">"user-focused"</span>
  ],
  basedIn: <span class="code-string">"Auckland"</span>
};</code></pre>

          <div class="snapshot-grid">
            <div><strong>3+</strong><span>years in frontend</span></div>
            <div><strong>2</strong><span>full-stack projects</span></div>
            <div><strong>1,100+</strong><span>animals rescued</span></div>
          </div>
        </aside>
      </header>

      <section class="section wrap" id="work" aria-labelledby="work-title">
        <div class="section-heading reveal">
          <p class="section-number">01 / Selected work</p>
          <div>
            <h2 id="work-title">Products built around real needs.</h2>
            <p>Two production-oriented projects spanning mobile, web, backend systems and third-party integrations.</p>
          </div>
        </div>

        <div class="project-list">
          <article class="project project-pethome reveal">
            <div class="project-visual" aria-hidden="true">
              <div class="phone phone-one">
                <span class="phone-label">Today’s care</span>
                <i></i><i></i><i></i>
              </div>
              <div class="phone phone-two">
                <span class="phone-label">Booking</span>
                <b>PetHome</b>
                <i></i><i></i>
              </div>
              <span class="project-index">01</span>
            </div>

            <div class="project-content">
              <div class="project-kicker"><span>Real business platform</span><span>In development</span></div>
              <h3>PetHome — Y&amp;T Paws</h3>
              <p class="project-summary">A bilingual mobile platform replacing manual booking, payment and daily care-update workflows for an Auckland pet-care business.</p>
              <ul class="project-points">
                <li>Designed customer, owner and staff workflows for bookings, pet profiles, services, care reports and notifications.</li>
                <li>Built a NestJS and Prisma API with JWT, business-scoped RBAC and transaction-safe capacity enforcement.</li>
                <li>Integrated Stripe webhooks, a verified WeChat payment flow, media uploads, localisation and push infrastructure.</li>
              </ul>
              <div class="tags" aria-label="PetHome technologies">
                <span>React Native</span><span>TypeScript</span><span>NestJS</span><span>PostgreSQL</span><span>Prisma</span><span>Stripe</span>
              </div>
              <a class="text-link" href="https://github.com/xiyunliu610/yt-paws-platform" target="_blank" rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>
            </div>
          </article>

          <article class="project project-chroma reveal">
            <div class="project-visual chroma-visual" aria-hidden="true">
              <span class="colour-orbit orbit-one"></span>
              <span class="colour-orbit orbit-two"></span>
              <span class="colour-orbit orbit-three"></span>
              <div class="chroma-panel">
                <small>COLLABORATIVE CHALLENGE</small>
                <strong>Find your city’s colours.</strong>
                <div><i></i><i></i><i></i><i></i></div>
              </div>
              <span class="project-index">02</span>
            </div>

            <div class="project-content">
              <div class="project-kicker"><span>Team of six</span><span>Frontend ownership</span></div>
              <h3>ChromaWalk</h3>
              <p class="project-summary">A location-based social web app for discovering, capturing and sharing colours through collaborative challenges.</p>
              <ul class="project-points">
                <li>Owned frontend delivery in an Agile team, building responsive React interfaces and reusable component architecture.</li>
                <li>Used Zustand and TanStack Query for predictable state and data fetching across iterative releases.</li>
                <li>Delivered real-time chat, live progress, Google OAuth, Maps location selection and client-side image compression.</li>
              </ul>
              <div class="tags" aria-label="ChromaWalk technologies">
                <span>React</span><span>TypeScript</span><span>Express</span><span>MongoDB</span><span>Socket.IO</span><span>Google Maps</span>
              </div>
              <a class="text-link" href="https://github.com/xiyunliu610/ChromaWalk" target="_blank" rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        </div>
      </section>

      <section class="section experience-section" id="experience" aria-labelledby="experience-title">
        <div class="wrap">
          <div class="section-heading reveal">
            <p class="section-number">02 / Experience</p>
            <div>
              <h2 id="experience-title">Engineering, ownership and service.</h2>
              <p>A career shaped by software delivery, operational leadership and long-term responsibility.</p>
            </div>
          </div>

          <div class="timeline">
            <article class="timeline-item reveal">
              <div class="timeline-date">Jul 2026 — Present</div>
              <div class="timeline-copy">
                <p class="timeline-type">Volunteer experience</p>
                <h3>Software Engineering Volunteer</h3>
                <p class="timeline-org">Rural Youth and Adult Literacy Trust (RYALT)</p>
                <p>Reviewed the WordPress platform with stakeholders, designed a backend refactoring strategy and now contribute to redevelopment focused on performance, maintainability and long-term scalability.</p>
              </div>
            </article>

            <article class="timeline-item reveal">
              <div class="timeline-date">Oct 2019 — May 2025</div>
              <div class="timeline-copy">
                <p class="timeline-type">Leadership &amp; operations</p>
                <h3>Founder &amp; Operations Lead</h3>
                <p class="timeline-org">Hangzhou Yatian Pet Products Co., Ltd. — Stray Animal Rescue Centre</p>
                <p>Founded and scaled a rescue centre caring for up to 300 dogs at once. Built repeatable workflows, coordinated volunteers and veterinary partners, and oversaw the rescue of 1,000+ dogs and 100+ cats.</p>
              </div>
            </article>

            <article class="timeline-item reveal">
              <div class="timeline-date">Apr 2016 — Oct 2019</div>
              <div class="timeline-copy">
                <p class="timeline-type">Professional experience</p>
                <h3>Software Engineer (Front-end)</h3>
                <p class="timeline-org">Isoftstone Information Technology Co., Ltd.</p>
                <p>Built Vue.js enterprise interfaces and ECharts visualisations, integrated REST APIs and collaborated across engineering and product. Reduced HTTP requests by 40% through CSS sprite-sheet optimisation.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section wrap" id="about" aria-labelledby="about-title">
        <div class="section-heading reveal">
          <p class="section-number">03 / About</p>
          <div>
            <h2 id="about-title">A methodical builder with an operator’s mindset.</h2>
          </div>
        </div>

        <div class="about-grid">
          <div class="about-copy reveal">
            <p>I’m a graduate software engineer currently completing a Master of Information Technology at the University of Auckland. I enjoy translating messy, real-world processes into software that is clear, dependable and useful.</p>
            <p>My experience spans frontend engineering, full-stack product development and more than five years of leading an animal rescue organisation. That combination taught me to ask better questions, make decisions under constraints and stay accountable for outcomes.</p>
            <blockquote>“Good software should feel useful before it feels impressive.”</blockquote>
          </div>

          <div class="about-cards reveal">
            <article class="info-card">
              <p>Education</p>
              <h3>Master of Information Technology</h3>
              <span>University of Auckland · Expected 2027</span>
            </article>
            <article class="info-card">
              <p>Based in</p>
              <h3>Auckland, New Zealand</h3>
              <span>Open to graduate software opportunities</span>
            </article>
          </div>
        </div>

        <div class="skills reveal" aria-labelledby="skills-title">
          <div class="skills-intro">
            <p class="section-number">Core toolkit</p>
            <h3 id="skills-title">Technologies I work with</h3>
          </div>
          <div class="skill-groups">
            <div><strong>Languages</strong><span>TypeScript · JavaScript · SQL · HTML · CSS</span></div>
            <div><strong>Frontend</strong><span>React · React Native · Vue.js · Svelte · Zustand · TanStack Query</span></div>
            <div><strong>Backend &amp; data</strong><span>Node.js · NestJS · Express · PostgreSQL · MySQL · MongoDB · Prisma</span></div>
            <div><strong>Practice</strong><span>Git · Docker · Agile/Scrum · Code reviews · Unit &amp; E2E testing</span></div>
          </div>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <div class="wrap contact-inner reveal">
          <p class="section-number">04 / Contact</p>
          <h2 id="contact-title">Let’s build something <em>useful.</em></h2>
          <p>I’m open to graduate software engineering opportunities and conversations about thoughtful, practical products.</p>
          <div class="contact-actions">
            <a class="button button-light" href="mailto:xliu713@aucklanduni.ac.nz">Say hello <span aria-hidden="true">→</span></a>
            <a class="button button-outline-light" href="https://www.linkedin.com/in/xiyun-liu/" target="_blank" rel="noopener noreferrer">View LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
          <div class="contact-links">
            <a href="mailto:xliu713@aucklanduni.ac.nz">Email</a>
            <a href="https://github.com/xiyunliu610" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            <a href="https://www.linkedin.com/in/xiyun-liu/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <span>© 2026 Lily Liu</span>
        <span>Designed &amp; built in Auckland</span>
      </div>
    </footer>
  </div>

  <script src="<%- url_for('/js/script.js') %>"></script>
</body>
</html>
